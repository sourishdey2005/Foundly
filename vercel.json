{
"functions": {
"api/**/*.php": {
"runtime": "vercel-php@0.7.3"
}
},
"routes": [
{
"src": "/css/(.*)",
"dest": "/css/$1"
},
{
"src": "/js/(.*)",
"dest": "/js/$1"
},
{
"src": "/admin/(.*)",
"dest": "/admin/$1"
},
{
"src": "/api/(.*)",
"dest": "/api/$1"
},
{
"src": "/(.*)",
"dest": "/api/index.php"
}
]
}
